{
  "name": "openrpc-mcp-server-updated",
  "version": "0.2.0",
  "description": "OpenRPC MCP server - Updated with latest @modelcontextprotocol/sdk for compatibility with newer clients",
  "main": "./build/index.js",
  "type": "module",
  "bin": {
    "openrpc-mcp-server": "./build/index.js"
  },
  "author": "hammad_ignite",
  "repository": {
    "type": "git",
    "url": "https://github.com/hammad-starmech/openrpc-mpc-server"
  },
  "homepage": "https://github.com/hammad-starmech/openrpc-mpc-server#readme",
  "bugs": {
    "url": "https://github.com/hammad-starmech/openrpc-mpc-server/issues"
  },
  "keywords": [
    "mcp",
    "openrpc",
    "json-rpc",
    "model-context-protocol"
  ],
  "license": "Apache-2.0",
  "files": [
    "build"
  ],
  "scripts": {
    "start": "node build/index.js",
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.18.1",
    "@open-rpc/client-js": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3"
  }
}
